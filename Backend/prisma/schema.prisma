generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String
  fullName        String
  role            String          @default("TUTOR") // TUTOR | GUARDIAN | ADMIN
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tutorProfile    TutorProfile?
}

model TutorProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio                 String?
  hourlyRate          Float    @default(40.0)
  
  // FR-PROF-04 Fields
  teachingModes       String   @default("[\"ONLINE\",\"IN_PERSON_TUTOR_HOME\",\"IN_PERSON_STUDENT_HOME\"]")
  geographicRadiusKm  Float    @default(15.0)
  availabilityCalendar String  @default("{\"monday\":[{\"start\":\"09:00\",\"end\":\"12:00\"},{\"start\":\"14:00\",\"end\":\"18:00\"}],\"tuesday\":[{\"start\":\"10:00\",\"end\":\"16:00\"}],\"wednesday\":[{\"start\":\"09:00\",\"end\":\"12:00\"}],\"thursday\":[{\"start\":\"14:00\",\"end\":\"19:00\"}],\"friday\":[{\"start\":\"09:00\",\"end\":\"15:00\"}],\"saturday\":[{\"start\":\"10:00\",\"end\":\"14:00\"}],\"sunday\":[]}")
  
  // FR-PROF-03 Fields (Background Credentials & Admin Audit Tagging)
  credentialPdfUrl    String?
  credentialFilename  String?
  uploadedAt          DateTime?
  verificationStatus  String   @default("PENDING_AUDIT") // PENDING_AUDIT | APPROVED | REJECTED
  adminReviewNote     String?
  reviewedAt          DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
